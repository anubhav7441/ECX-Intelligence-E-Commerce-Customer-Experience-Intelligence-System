# Copy to .env if you want to override defaults (the app also runs without any .env).
SECRET_KEY=change-me
DATABASE_URL=sqlite:///database/ecx.db

# --- optional settings (all have safe defaults) ---
# ECX_API_RATE_LIMIT=120          # requests per minute per API key
# ECX_DIGEST_DIR=reports/digests  # where digest files are written
# E-mail for the digest stays OFF unless ALL of these are set. Put real values only in your private .env, never in code or in git.
# ECX_SMTP_HOST=
# ECX_SMTP_PORT=587
# ECX_SMTP_USER=
# ECX_SMTP_PASSWORD=
# ECX_SMTP_FROM=
# ECX_DIGEST_TO=
# ECX_METRICS_TOKEN=              # set a long random value to turn ON /metrics (Prometheus format); leave unset to keep it OFF
# ECX_LOG_JSON=1                  # write logs as JSON lines instead of plain text
# ECX_MONITOR_INTERVAL_HOURS=24   # how often the optional scheduler runs the monitor and writes the digest

# --- access control ---
# ECX_SIGNUP_MODE=auto            # open | email | admin | auto.  email = 6-digit code sent to the new user's address; admin = an administrator approves;
#                                 open = no check; auto = email if the ECX_SMTP_* settings above are all filled in (ECX_DIGEST_TO is not needed), else open
# ECX_ADMIN_PATH=/control-room    # URL of the administrator page; change it to something only you know
# For Gmail: ECX_SMTP_HOST=smtp.gmail.com  ECX_SMTP_PORT=587  ECX_SMTP_USER=you@gmail.com  ECX_SMTP_FROM=you@gmail.com
#            ECX_SMTP_PASSWORD=<a Google "App password" (needs 2-step verification), not your normal password>
